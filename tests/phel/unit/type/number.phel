                    (z/nonnegative s))
        result (z/safe-parse my-schema "-1")]
    (is (= false (result :success)))
    (is (= "Phel\PhelSchema\ZodError" (php/get_class (result :error))))
    (is (= "Not nonnegative" (get-in (result :issues) [0 :message])))))

(deftest test-number-negative-ok
  (let [my-schema (as-> (z/number) s
                    (z/negative s))
        result (z/safe-parse my-schema "-1")]
    (is (= true (result :success)))
    (is (= "-1" (result :data)))))

(deftest test-number-negative-ng
  (let [my-schema (as-> (z/number) s
                    (z/negative s))
        result (z/safe-parse my-schema "0")]
    (is (= false (result :success)))
    (is (= "Phel\PhelSchema\ZodError" (php/get_class (result :error))))
    (is (= "Not negative" (get-in (result :issues) [0 :message])))))

(deftest test-number-nonpositive-ok
  (let [my-schema (as-> (z/number) s
                    (z/nonpositive s))
        result (z/safe-parse my-schema "0")]
    (is (= true (result :success)))
    (is (= "0" (result :data)))))

(deftest test-number-nonpositive-ng
  (let [my-schema (as-> (z/number) s
                    (z/nonpositive s))
        result (z/safe-parse my-schema "1")]
    (is (= false (result :success)))
    (is (= "Phel\PhelSchema\ZodError" (php/get_class (result :error))))
    (is (= "Not nonpositive" (get-in (result :issues) [0 :message])))))

(deftest test-number-rule-keys
  (is (= :gt (get-in (z/gt (z/number) 5) [:rules 2 :key])))
  (is (= :gte (get-in (z/gte (z/number) 5) [:rules 2 :key])))
  (is (= :lt (get-in (z/lt (z/number) 5) [:rules 2 :key])))
  (is (= :lte (get-in (z/lte (z/number) 5) [:rules 2 :key])))
  (is (= :int (get-in (z/int (z/number)) [:rules 2 :key])))
  (is (= :positive (get-in (z/positive (z/number)) [:rules 2 :key])))
  (is (= :nonnegative (get-in (z/nonnegative (z/number)) [:rules 2 :key])))
  (is (= :negative (get-in (z/negative (z/number)) [:rules 2 :key])))
  (is (= :nonpositive (get-in (z/nonpositive (z/number)) [:rules 2 :key]))))
