(ns phel.tests.unit.custom
  (:require phel.test :refer [deftest is])
  (:require phel.schema :as z))

(deftest test-string-parse-ok
  (let [my-schema (z/string)
        my-schema (z/custom my-schema #(= (php/mb_strlen %) 4) "length must be 4")]
    (is (= "tuna" (z/parse my-schema "tuna")))))

(deftest test-string-parse-ng
  (let [my-schema (z/string)
        my-schema (z/custom my-schema #(= (php/mb_strlen %) 4) "length must be 4")]
    (is (thrown? \Exception (z/parse my-schema 12)))))

(deftest test-string-safe-parse-ok
  (let [my-schema (z/string)
        my-schema (z/custom my-schema #(= (php/mb_strlen %) 4) "length must be 4")
        result (z/safe-parse my-schema "tuna")]
    (is (= true (result :success)))
    (is (= "tuna" (result :data)))))

(deftest test-string-safe-parse-ng
  (let [my-schema (z/string)
        my-schema (z/custom my-schema #(= (php/mb_strlen %) 4) "length must be 4")
        result (z/safe-parse my-schema "12345")]
    (is (= false (result :success)))
    (is (= "Phel\PhelSchema\ZodError" (php/get_class (result :error))))
    (is (= "length must be 4" (get-in (result :issues) [0 :message])))))


(deftest test-safe-parse-non-schema-throws
  (is (thrown? \InvalidArgumentException (z/safe-parse nil 1)))
  (is (thrown? \InvalidArgumentException (z/safe-parse {:rules [] :children {}} 1)))
  (is (thrown? \InvalidArgumentException (z/parse nil 1))))

(deftest test-custom-options-map-message
  (let [my-schema (z/custom (z/string) #(= (php/mb_strlen %) 4) {:message "must be 4"})
        result (z/safe-parse my-schema "12345")]
    (is (= "must be 4" (get-in (result :issues) [0 :message])))))

(deftest test-custom-default-message
  (let [my-schema (z/custom (z/string) #(= (php/mb_strlen %) 4))
        result (z/safe-parse my-schema "12345")]
    (is (= "Invalid value" (get-in (result :issues) [0 :message])))))

(deftest test-custom-bare-string-message-deprecated-form
  (let [my-schema (z/custom (z/string) #(= (php/mb_strlen %) 4) "bare message")
        result (z/safe-parse my-schema "12345")]
    (is (= "bare message" (get-in (result :issues) [0 :message])))))

(deftest test-custom-malformed-options-throw
  (is (thrown? \InvalidArgumentException (z/custom (z/string) (fn [x] true) :oops)))
  (is (thrown? \InvalidArgumentException (z/custom (z/string) (fn [x] true) [1 2]))))
