(ns phel.schema.type.custom
  (:require phel.schema.interfaces :refer [add-rule]))

(defn custom
  "Adds a rule that passes when `(test value)` is truthy. The options map takes
  `:message`. A bare string is still accepted as the message but is deprecated."
  [s test & [options]]
  (when-not (or (nil? options) (string? options) (map? options))
    (throw (new \InvalidArgumentException "The options of custom must be a map")))
  (let [message (if (string? options)
                  options
                  (or (get options :message) "Invalid value"))]
    (add-rule s :custom test message)))
