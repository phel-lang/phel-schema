(ns phel.schema.type.number
  (:require phel.schema.interfaces :refer [typed-schema add-rule]))

(defn- finite-number? [x]
  (and (number? x) (not (php/is_nan x)) (not (php/is_infinite x))))

(defn number []
  (typed-schema finite-number? {}))

(defn gt [s n & [{message :message}]]
  (add-rule s :gt #(> % n) (or message "Too small")))

(defn gte [s n & [{message :message}]]
  (add-rule s :gte #(>= % n) (or message "Too small")))

(defn lt [s n & [{message :message}]]
  (add-rule s :lt #(< % n) (or message "Too large")))

(defn lte [s n & [{message :message}]]
  (add-rule s :lte #(<= % n) (or message "Too large")))

(defn int [s & [{message :message}]]
  (add-rule s :int #(or (int? %) (= % (php/floor %))) (or message "Not integer")))

(defn positive [s & [{message :message}]]
  (add-rule s :positive #(> % 0) (or message "Not positive")))

(defn nonnegative [s & [{message :message}]]
  (add-rule s :nonnegative #(>= % 0) (or message "Not nonnegative")))

(defn negative [s & [{message :message}]]
  (add-rule s :negative #(< % 0) (or message "Not negative")))

(defn nonpositive [s & [{message :message}]]
  (add-rule s :nonpositive #(<= % 0) (or message "Not nonpositive")))
