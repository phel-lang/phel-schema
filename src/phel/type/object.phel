(ns phel.schema.type.object
  (:require phel.schema.interfaces :refer [schema schema?]))

(defstruct rule-object [key test message])

(defn object [& [children]]
  (when-not (or (nil? children) (map? children))
    (throw (new \InvalidArgumentException "The children of object must be a map")))
  (doseq [[k v] :pairs (or children {})]
    (when-not (schema? v)
      (throw (new \InvalidArgumentException (str "Child " k " of object is not a schema")))))
  (schema [(rule-object :required_error (fn [x] (not (nil? x))) "Required")
           (rule-object :invalid_type_error map? "Invalid type")]
          children))

