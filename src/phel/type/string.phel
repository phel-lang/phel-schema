(ns phel.schema.type.string
  (:require phel.schema.interfaces :refer [schema]))

(defstruct rule-string [key test message])

(defn string []
  (schema [(rule-string :required_error (fn [x] (not (nil? x))) "Required")
           (rule-string :invalid_type_error string? "Invalid type")]
          {}))

(defn max [s n & [{message :message}]]
  (assoc s :rules
    (conj
      (s :rules)
      (rule-string :max (fn [x] (<= (php/mb_strlen x) n)) (or message "Too long")))))

(defn min [s n & [{message :message}]]
  (assoc s :rules
    (conj
      (s :rules)
      (rule-string :min (fn [x] (>= (php/mb_strlen x) n)) (or message "Too short")))))

(defn length [s n & [{message :message}]]
  (assoc s :rules
    (conj
      (s :rules)
      (rule-string :length (fn [x] (= (php/mb_strlen x) n)) (or message "Wrong length")))))

(defn- pcre-match [pattern subject]
  (php/set_error_handler (fn [_ message] (throw (new \InvalidArgumentException message))))
  (try
    (php/preg_match pattern subject)
    (finally (php/restore_error_handler))))

(defn- regex-matches? [regexp x]
  (let [result (pcre-match regexp x)]
    (cond
      (= result 1) true
      (= result 0) false
      (= (php/preg_last_error) php/PREG_BAD_UTF8_ERROR) false
      :else (throw (new \RuntimeException (php/preg_last_error_msg))))))

(defn regex
  "Adds a PCRE rule. Throws `InvalidArgumentException` when `regexp` does not
  compile. A subject that is not valid UTF-8 for a `/u` pattern fails the rule;
  any other PCRE runtime error throws `RuntimeException`."
  [s regexp & [{message :message}]]
  (pcre-match regexp "")
  (assoc s :rules
    (conj
      (s :rules)
      (rule-string :regex (fn [x] (regex-matches? regexp x)) (or message "Not match")))))
