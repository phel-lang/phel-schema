(ns phel.schema
  (:use Phel.PhelSchema.ZodError)
  (:require phel.schema.interfaces :refer [schema schema? validate])
  (:require phel.schema.type.number :as n)
  (:require phel.schema.type.string :as s)
  (:require phel.schema.type.object :as o))

(defn string [& args] (apply s/string args))
(defn max [& args] (apply s/max args))
(defn min [& args] (apply s/min args))
(defn length [& args] (apply s/length args))
(defn regex [& args] (apply s/regex args))

(defn number [& args] (apply n/number args))
(defn gt [& args] (apply n/gt args))
(defn gte [& args] (apply n/gte args))
(defn lt [& args] (apply n/lt args))
(defn lte [& args] (apply n/lte args))
(defn int [& args] (apply n/int args))
(defn positive [& args] (apply n/positive args))
(defn nonnegative [& args] (apply n/nonnegative args))
(defn negative [& args] (apply n/negative args))
(defn nonpositive [& args] (apply n/nonpositive args))

(defn object [& args] (apply o/object args))

(declare get-issues)

(defn- get-parent-issues [schema paths target]
  (loop [rules (schema :rules)
         paths paths
         acc []]
    (if (empty? rules)
      acc
      (let [rule (first rules)]
        (recur (rest rules) paths (concat acc (validate rule paths target)))))))

(defn- get-children-issues [schema paths target]
  (reduce concat [] (for [[k v] :pairs (schema :children)]
                      (if (schema? v)
                        (get-issues v (conj paths k) (target k))
                        []))))

(defn- get-issues [schema paths target]
  (concat
    (get-parent-issues schema paths target)
    (get-children-issues schema paths target)))

(defn safe-parse [schema target]
  (let [issues (get-issues schema [] target)]
    (if (empty? issues)
      {:success true
       :data target
       :issues []}
      {:success false
       :error (ZodError/create "Zod Error" (to-array issues))
       :issues issues})))

(defn parse [schema target]
  (let [result (safe-parse schema target)]
    (if (result :success)
      (result :data)
      (throw (result :error)))))

(defstruct rule-custom [key test message])

(defn custom [s test message]
  (assoc s :rules
    (conj
      (s :rules)
      (rule-custom :custom test message))))

